<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="player-webui"
        Arguments=""
        InstallLocation="C:\Program Files\dlcuy22\Player">
    </Installer>
    <PackageInformation
        PackageName="Player"
        PackageDisplayName="MoLow"
        PublisherName="CN=dlcuy22"
        PublisherDisplayName="dlcuy22"
        Version="0.4.0.0"
        PackageDescription="MoLow Music player and library manager">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.dlcuy22.MoLow"
                Description="MoLow Music player and library manager"
                DisplayName="MoLow"
                ExecutableName="MoLow"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Player</DisplayName>
            <PublisherDisplayName>dlcuy22</PublisherDisplayName>
            <Description>MoLow Music player and library manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="player-webui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
